[Unit]
Description=Update and announce the Silent Selene production release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=silentselene-deploy
Group=silentselene-deploy
StandardOutput=journal
StandardError=journal
WorkingDirectory=/home/silentselene/silentselene
EnvironmentFile=/etc/silentselene/deploy.env
ExecStart=/home/silentselene/silentselene/ref/deploy/update.py --repository /home/silentselene/silentselene --actor silentselene-deploy
ExecStartPost=+/bin/systemctl reload silentselene.service
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/silentselene/silentselene
